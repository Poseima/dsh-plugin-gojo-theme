{
  "name": "dsh-plugin-gojo-theme",
  "version": "0.3.46",
  "description": "GOJO Harness · DeepSeek Harness 冷白蓝工作台主题",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./lib/workbench-host.js",
    "./client": "./build/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "assets/workbench/*.woff",
    "assets/workbench/*-OFL.txt",
    "assets/workbench/ink-*.webp",
    "assets/workbench/six-eyes.svg",
    "assets/workbench/stream-orbs.webp",
    "assets/workbench/fork-domain/paper.webp",
    "assets/workbench/records/ice-vinyl.webp",
    "lib/workbench-host.js",
    "lib/workbench-media.js",
    "lib/workbench-voice-assets.js",
    "build/client.js",
    "cordis.patch.yml",
    "README.md",
    "ASSETS.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
  },
  "scripts": {
    "build": "node build.mjs",
    "test": "node --test tests/*.test.js",
    "pack:local": "npm run build && mkdir -p dist && npm pack --pack-destination dist"
  },
  "devDependencies": {
    "esbuild": "0.25.12",
    "playwright-core": "1.56.1"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Poseima/dsh-plugin-gojo-theme.git"
  }
}
